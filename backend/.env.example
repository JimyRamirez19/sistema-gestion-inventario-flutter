# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO PARA EL BACKEND (FastAPI + JWT)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copie este archivo como '.env' en la carpeta backend/.
# 2. Genere una clave secreta criptográficamente segura ejecutando:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. Asigne el valor generado a la variable SECRET_KEY.
# 4. Configure las credenciales iniciales para la siembra del usuario administrador.
# 5. NUNCA publique el archivo '.env' con valores reales en repositorios públicos.
# ==============================================================================

# Clave secreta para la firma y verificación simétrica de los JSON Web Tokens (JWT)
SECRET_KEY=clave_secreta_de_ejemplo_para_desarrollo_cambiar_por_token_aleatorio

# Algoritmo de firma digital HMAC con función hash SHA-256
ALGORITHM=HS256

# Tiempo de vigencia del token de acceso en minutos antes de expirar
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Credenciales del usuario administrador sembrado al iniciar la aplicación
SEED_ADMIN_NAME=Administrador del Sistema
SEED_ADMIN_EMAIL=admin@inventario.com
SEED_ADMIN_PASSWORD=EjemploContrasenaSegura123*
